# Web
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Set to true to temporarily replace the home screen with the maintenance page.
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Backend persistence. Local development always uses PostgreSQL.
FLY_PERSISTENCE=postgres

# PostgreSQL (local/test)
FLY_BACKEND_PORT=8080
FLY_DATABASE_URL=jdbc:postgresql://localhost:55432/flyae
FLY_DATABASE_USER=flyae
FLY_DATABASE_PASSWORD=flyae

# DynamoDB (V0-Prod). Leave endpoint and credentials empty on AWS to use IAM.
FLY_DYNAMODB_ENDPOINT=
FLY_DYNAMODB_REGION=eu-central-1
FLY_DYNAMODB_TABLE=fly-ae-v0-prod
FLY_DYNAMODB_CREATE_TABLE=false
FLY_DYNAMODB_ACCESS_KEY=
FLY_DYNAMODB_SECRET_KEY=

# Backend
FLY_ALLOWED_ORIGINS=http://localhost:3000
FLY_SESSION_SECRET=replace-with-at-least-32-random-characters
FLY_GUEST_SESSION_TTL=12h
FLY_GUEST_MAX_FILE_SIZE_BYTES=104857600
FLY_AUTHENTICATED_MAX_FILE_SIZE_BYTES=3221225472
FLY_OTP_PEPPER=replace-with-at-least-32-random-characters
FLY_SHARE_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
FLY_PUBLIC_BASE_URL=http://localhost:3000

# Telegram OTP. Create the bot with @BotFather and register the HTTPS webhook
# documented in README.md before enabling this in a public environment.
FLY_TELEGRAM_ENABLED=false
FLY_TELEGRAM_BOT_TOKEN=
FLY_TELEGRAM_BOT_USERNAME=FlyAeOtpBot
FLY_TELEGRAM_WEBHOOK_SECRET=replace-with-16-or-more-url-safe-random-characters
FLY_TELEGRAM_API_BASE_URL=https://api.telegram.org
# Private chat ID that receives upload alerts and can use admin bot commands.
FLY_TELEGRAM_ADMIN_CHAT_ID=0

# Private S3 / local MinIO
FLY_S3_ENDPOINT=http://localhost:9000
FLY_S3_REGION=us-east-1
FLY_S3_BUCKET=fly-ae-documents
FLY_S3_ACCESS_KEY=flyae
FLY_S3_SECRET_KEY=replace-for-non-local-use
FLY_S3_PATH_STYLE=true
FLY_UPLOAD_SIGNATURE_TTL=PT1H

# Future queue adapter (local V0 uses in-process JobQueue)
FLY_QUEUE_ADAPTER=local
FLY_SQS_QUEUE_URL=
