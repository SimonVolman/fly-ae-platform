# Web
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Backend and PostgreSQL
FLY_BACKEND_PORT=8080
FLY_DATABASE_URL=jdbc:postgresql://localhost:55432/flyae
FLY_DATABASE_USER=flyae
FLY_DATABASE_PASSWORD=flyae
FLY_ALLOWED_ORIGINS=http://localhost:3000
FLY_SESSION_SECRET=replace-with-at-least-32-random-characters
FLY_GUEST_SESSION_TTL=12h
FLY_GUEST_MAX_FILE_SIZE_BYTES=10485760
FLY_AUTHENTICATED_MAX_FILE_SIZE_BYTES=104857600
FLY_OTP_PEPPER=replace-with-at-least-32-random-characters
FLY_SHARE_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
FLY_PUBLIC_BASE_URL=http://localhost:3000

# Private S3 / local MinIO
FLY_S3_ENDPOINT=http://localhost:9000
FLY_S3_REGION=us-east-1
FLY_S3_BUCKET=fly-ae-documents
FLY_S3_ACCESS_KEY=flyae
FLY_S3_SECRET_KEY=replace-for-non-local-use
FLY_S3_PATH_STYLE=true
FLY_UPLOAD_SIGNATURE_TTL=PT1H

# Future queue adapter (local V0 uses in-process JobQueue)
FLY_QUEUE_ADAPTER=local
FLY_SQS_QUEUE_URL=
