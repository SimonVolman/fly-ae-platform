{
  "name": "fly-ae",
  "version": "0.1.0",
  "description": "Secure sharing of technical documentation for aircraft components.",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @fly-ae/web",
    "backend": "./scripts/start-backend.sh",
    "build": "npm run build --workspace @fly-ae/web",
    "lint": "npm run lint --workspace @fly-ae/web",
    "test": "npm run test:web",
    "test:web": "npm run test --workspace @fly-ae/web",
    "test:backend": "./apps/backend/gradlew -p apps/backend test",
    "happy-path": "node scripts/happy-path.mjs",
    "happy-path:guest": "node scripts/guest-happy-path.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "npm run db:generate --workspace @fly-ae/web"
  }
}
