  "components": {
    "brand": {
      "css": [".brand", ".brand-mark", ".brand-word"],
      "canonicalMark": "fly-loop-variant-3",
      "figmaVariants": ["Brand / Variant 3", "Brand / Variant 4", "Brand / Variant 5"],
      "appIcon": "fly-loop mark without wordmark",
      "rules": [
        "Use the fly/infinity loop mark with the central beacon; never use the legacy airplane mark.",
        "Use the navy lockup on light surfaces and the white lockup on navy.",
        "Keep clear space equal to the cap height of the wordmark.",
        "Do not underline, stretch or recolour individual letters."
      ]
    },
    "button": {
      "css": [
        ".button-primary",
        ".button-success",
        ".button-secondary",
        ".button-tertiary",
        ".button-icon"
      ],
      "height": "44px",
      "rules": [
        "Use one primary action per surface.",
        "Use compact rectangular controls with a 6px radius.",
        "Use verb-led labels."
      ]
    },
    "field": {
      "css": [".field", ".dialog input"],
      "height": "44px",
      "rules": [
        "Keep the label visible above the control.",
        "Mark required fields with the danger token.",
        "Show validation text below the field."
      ]
    },
    "message": {
      "css": [".message-info", ".message-warning", ".message-success"],
      "rules": [
        "Use colour only to communicate system meaning.",
        "Pair colour with a clear heading and explanatory text."
      ]
    },
    "categoryCard": {
      "css": [".folder-card", ".empty-folder-card"],
      "rules": [
        "Use the sky-to-deep-sky gradient.",
        "Show one category, one identifier and one metadata line."
      ]
    },
    "dialog": {
      "css": [".dialog", ".dialog-top", ".dialog-actions"],
      "rules": [
        "Use a 14px radius.",
        "Place the close control in the top-right corner.",
        "Keep the primary action in the bottom action area."
      ]
    }
  },
  "patterns": {
    "navigation": {
      "desktop": "Brand left, product navigation centred, identity or login right.",
      "mobile": "Brand left, identity and menu action right."
    },
    "uploadFlow": [
      "Choose a document category and enter MSN",
      "Upload one text PDF to private storage",
      "Create a protected link after approval"
    ],
    "authenticationFlow": [
      "Enter an email address",
      "Enter the one-time code",
      "Return to the interrupted product action"
    ],
    "history": "Use category cards for empty states and compact rows for My Documents."
  },
