  "governance": {
    "sourceOfTruthOrder": [
      "Approved Figma UI Kit",
      "docs/design-system.json",
      "CSS custom properties in app/globals.css",
      "Component and screen implementations"
    ],
    "changeRule": "Update the manifest, CSS tokens, living style guide and affected tests in the same change."
  }
