  "principles": [
    {
      "id": "precise",
      "title": "Precise",
      "description": "Technical information is compact, aligned and easy to scan."
    },
    {
      "id": "secure",
      "title": "Secure",
      "description": "Actions and system states are explicit; the interface never hides consequences."
    },
    {
      "id": "efficient",
      "title": "Efficient",
      "description": "Each surface has one primary action and short verb-led labels."
    }
  ],
